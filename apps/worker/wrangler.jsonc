{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Un seul Worker sert l'application (assets statiques), l'API et, plus tard,
  // la fiche publique de la médaille. Voir docs/decisions/0001-worker-unique.md.
  "name": "eko-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Le Worker voit toutes les requêtes pour appliquer partout les mêmes en-têtes de sécurité.
    "run_worker_first": true
  },
  "observability": { "enabled": true },
  "triggers": { "crons": ["0 3 * * *"] },
  "vars": {
    "ENVIRONMENT": "development",
    "RP_ID": "localhost",
    "RP_NAME": "EKO",
    "ORIGIN": "http://localhost:8787"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "eko-dev",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "env": {
    "staging": {
      "name": "eko-staging",
      // Seul le domaine personnalisé sert l'app : pas d'adresse workers.dev ni d'URL de prévisualisation.
      "workers_dev": false,
      "preview_urls": false,
      "routes": [{ "pattern": "staging.eko-companion.fr", "custom_domain": true }],
      "triggers": { "crons": ["0 3 * * *"] },
      "vars": {
        "ENVIRONMENT": "staging",
        "RP_ID": "staging.eko-companion.fr",
        "RP_NAME": "EKO (test)",
        "ORIGIN": "https://staging.eko-companion.fr"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "eko-staging",
          "database_id": "fb9031de-c1a1-4440-8372-a0c5a738d6a9",
          "migrations_dir": "migrations"
        }
      ]
    },
    "production": {
      "name": "eko",
      // Seul le domaine personnalisé sert l'app : pas d'adresse workers.dev ni d'URL de prévisualisation.
      "workers_dev": false,
      "preview_urls": false,
      // Domaine encodé dans le QR de la médaille : ne plus le changer (voir docs/decisions/0003-domaine-personnel.md).
      "routes": [{ "pattern": "eko-companion.fr", "custom_domain": true }],
      "triggers": { "crons": ["0 3 * * *"] },
      "vars": {
        "ENVIRONMENT": "production",
        "RP_ID": "eko-companion.fr",
        "RP_NAME": "EKO",
        "ORIGIN": "https://eko-companion.fr"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "eko-prod",
          "database_id": "17a3f8a1-7b80-4c3c-9a6a-8265e4c973b6",
          "migrations_dir": "migrations"
        }
      ]
    }
  }
}
